function msvg(M,T){let s='<svg viewBox="0 0 210 145"><rect width="210" height="145" fill="white"/>';[52,62,72,82,92].forEach(q=>s+=`<line x1="5" y1="${q}" x2="205" y2="${q}" stroke="#222"/>`);M.notes.forEach((N,i)=>{let x=30+i*48;s+=noteGlyph(N,x,T)});s+=`<line x1="205" y1="52" x2="205" y2="92" stroke="#222" stroke-width="2"/>`;return s+'</svg>'}
const sharpY={f:52,c:67,g:47,d:62},flatY={b:72,e:57,a:77,d:62};function hsvg(T){let s='<svg viewBox="0 0 190 140"><rect width="190" height="140" fill="white"/>';[52,62,72,82,92].forEach(q=>s+=`<line x1="5" y1="${q}" x2="185" y2="${q}" stroke="#222"/>`);s+='<text x="10" y="91" font-size="42" font-family="serif">𝄞</text>';T.sig.forEach((a,i)=>{let yy=a[0]==='#'?sharpY[a[1]]:flatY[a[1]];s+=`<text x="${58+i*17}" y="${yy+8}" font-size="25" font-family="serif">${a[0]==='#'?'♯':'♭'}</text>`});return s+'</svg>'}
