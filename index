function wire(p){p.draggable=true;p.onclick=e=>{e.stopPropagation();selectPiece(p)};p.ondragstart=e=>{selected=p;e.dataTransfer.effectAllowed='move';e.dataTransfer.setData('text/plain',p.dataset.id)}}
function showPuzzle(exercise){if(exercise!==E())throw new Error('Puzzle/exercice désynchronisé');document.querySelector('#stage2').classList.remove('hidden');document.querySelector('#keyFound').textContent='✓ Tonalité reconnue : '+exercise.T.name+' · palier '+(exercise.tier+1)+'/5 · tessiture La3–Do5';let P=document.querySelector('#pieces'),S=document.querySelector('#slots');P.dataset.exercise=String(ix);S.dataset.exercise=String(ix);P.innerHTML=S.innerHTML='';let cards=[],h=document.createElement('div');h.className='piece';h.dataset.id='H';h.innerHTML=`<div class="notation">${hsvg(exercise.T)}</div>`;wire(h);cards.push(h);E().measures.forEach(M=>{let p=document.createElement('div');p.className='piece';p.dataset.id=M.id;p.innerHTML=`<div class="notation">${msvg(M,exercise.T)}</div>`;wire(p);cards.push(p)});cards.sort(()=>Math.random()-.5).forEach(x=>P.appendChild(x));P.onclick=e=>{if(e.target===P&&selected){P.appendChild(selected);clearSelection()}};P.ondragover=e=>e.preventDefault();P.ondrop=e=>{e.preventDefault();let p=document.querySelector(`.piece[data-id="${e.dataTransfer.getData('text/plain')}"]`)||selected;if(p){P.appendChild(p);clearSelection()}};for(let i=0;i<5;i++){let q=document.createElement('div');q.className='slot';q.onclick=e=>{let clicked=e.target.closest('.piece');if(clicked){if(selected&&selected!==clicked)movePiece(selected,q);else selectPiece(clicked)}else if(selected)movePiece(selected,q)};q.ondragover=e=>{e.preventDefault();e.dataTransfer.dropEffect='move'};q.ondrop=e=>{e.preventDefault();let p=document.querySelector(`.piece[data-id="${e.dataTransfer.getData('text/plain')}"]`)||selected;movePiece(p,q)};S.appendChild(q)}}
document.querySelector('#checkPuzzle').onclick=()=>{puzzleAttempts++;if(document.querySelector('#slots').dataset.exercise!==String(ix)){throw new Error('Le puzzle affiché ne correspond pas à l’exercice courant')}let ids=[...document.querySelector('#slots').children].map(s=>s.querySelector('.piece')?.dataset.id),ok=ids.join('')==='HABCD',m=document.querySelector('#puzzleMsg');m.className=ok?'ok':'bad';m.textContent=ok?'✓ Puzzle correct':'Ordre incorrect';document.querySelector('#next').classList.add('hidden');if(ok){if(puzzleAttempts===1)score++;setTimeout(()=>finishExercise(),450)}};function showCelebration(title,text,final=false){document.querySelector('#celebrationTitle').textContent=title;document.querySelector('#celebrationText').textContent=text;document.querySelector('#celebration').classList.remove('hidden');document.querySelector('#continueBtn').classList.toggle('hidden',final);document.querySelector('#downloadBtn').classList.toggle('hidden',!final)}
function advanceExercise(){ix=(ix+1)%40;answer=null;selected=null;keyAttempts=0;puzzleAttempts=0;document.querySelector('#stage2').classList.add('hidden');document.querySelector('#stage1').classList.remove('hidden');document.querySelector('#keyMsg').textContent='';document.querySelector('#puzzleMsg').textContent='';document.querySelector('#bar').style.width=`${(ix+1)*2.5}%`;document.querySelector('#count').textContent=`Exercice ${ix+1} / 40`;answers()}
function finishExercise(){let completed=ix+1;if(completed===40){showCelebration('Bravo ! Parcours terminé',`Score : ${score} / 80 points. Tu as terminé les 40 exercices de reconnaissance tonale et de puzzle musical.`,true)}else if(completed%8===0){showCelebration(`Bravo ! Palier ${completed/8} terminé`,`Tu as réussi ${completed} exercices. Score actuel : ${score} / ${completed*2}.`)}else advanceExercise()}
document.querySelector('#continueBtn').onclick=()=>{document.querySelector('#celebration').classList.add('hidden');advanceExercise()};
document.querySelector('#downloadBtn').onclick=()=>{let txt=`THELABO — FÉLICITATIONS\n\nParcours : Reconnaissance tonale et puzzle de phrases\nExercices terminés : 40 / 40\nScore : ${score} / 80\n\nBravo pour ce parcours !`;let blob=new Blob([txt],{type:'text/plain;charset=utf-8'}),a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='TheLabo_Felicitations_Score.txt';a.click();setTimeout(()=>URL.revokeObjectURL(a.href),500)};
document.querySelector('#next').onclick=finishExercise;answers();document.querySelector('#bar').style.width='2.5%';if(CONTOUR_ERRORS.length){document.querySelector('#keyMsg').className='bad';document.querySelector('#keyMsg').textContent='Erreur contours : '+CONTOUR_ERRORS[0];document.querySelector('#listen').disabled=true;}else if(NOTATION_ERRORS.length){document.querySelector('#keyMsg').className='bad';document.querySelector('#keyMsg').textContent='Erreur interne écriture/audio : '+NOTATION_ERRORS[0];document.querySelector('#listen').disabled=true;}
</script></body></html>
