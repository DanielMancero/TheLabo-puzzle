function staffY(N){return 102-((N.oct-4)*7+DI[N.l])*5}
function ledger(x,y){let s='';if(y>=102){for(let ly=102;ly<=y;ly+=10)s+=`<line x1="${x-9}" y1="${ly}" x2="${x+9}" y2="${ly}" stroke="#222"/>`}if(y<=42){for(let ly=42;ly>=y;ly-=10)s+=`<line x1="${x-9}" y1="${ly}" x2="${x+9}" y2="${ly}" stroke="#222"/>`}return s}
