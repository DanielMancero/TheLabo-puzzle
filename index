function buildSession(){let result=[],used=new Set();for(let tier=0;tier<5;tier++){for(let j=0;j<8;j++){let c,sig,guard=0;do{c=generateContourForTier(tier);sig=contourSig(c);guard++}while(used.has(sig)&&guard<500);used.add(sig);let T=K[Math.floor(Math.random()*K.length)],measures=c.map((m,mi)=>({id:'ABCD'[mi],notes:m.map((d,ni)=>({...fitMelodyDegree(T,d),dur:1}))}));result.push({T,measures,contour:c,contourIndex:sig,tier})}}return result}
const EX=buildSession();function validateNotationAudio(){let er=[];EX.forEach((E,ei)=>E.measures.forEach((M,mi)=>M.notes.forEach((N,ni)=>{let expected=(N.oct+1)*12+NAT[N.l]+N.a;if(expected!==N.m)er.push(`Ex ${ei+1} M${mi+1} N${ni+1}: écrit ${N.l}${N.a===1?'#':N.a===-1?'b':''}${N.oct} = MIDI ${expected}, audio MIDI ${N.m}`)})));return er}const NOTATION_ERRORS=validateNotationAudio();function contourSignature(E){return E.measures.flatMap(M=>M.notes.map(N=>N.degree||0)).join('-')}function validateContours(){let er=[],sigs=EX.map(E=>contourSig(E.contour));if(new Set(sigs).size!==40)er.push('La session ne contient pas 40 contours uniques');EX.forEach((E,i)=>{if(E.contour[3][3]!==1)er.push('Ex '+(i+1)+' : conclusion non tonique');if(E.tier!==Math.floor(i/8))er.push('Ex '+(i+1)+' : palier incorrect');E.measures.forEach(M=>M.notes.forEach(N=>{if(N.m<MELODY_MIN||N.m>MELODY_MAX)er.push('Ex '+(i+1)+' : note hors La3–Do5')}))});return er}const CONTOUR_ERRORS=validateContours();let ix=0,answer=null,selected=null,audio=null,nodes=[],masterGain=null;let masterVolume=.70,score=0,keyAttempts=0,puzzleAttempts=0;const E=()=>EX[ix];
function tone(m,t,d=.6){let o=audio.createOscillator(),g=audio.createGain();o.type='sine';o.frequency.value=hz(m);g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(.1,t+.01);g.gain.exponentialRampToValueAtTime(.0001,t+d);o.connect(g).connect(masterGain);o.start(t);o.stop(t+d+.02);nodes.push(o)}function ctx(){if(!audio){audio=new(window.AudioContext||window.webkitAudioContext)();masterGain=audio.createGain();masterGain.gain.value=masterVolume;masterGain.connect(audio.destination)}if(audio.state==='suspended')audio.resume()}function tuningFork440(){ctx();let t=audio.currentTime+.03,o=audio.createOscillator(),g=audio.createGain();o.type='sine';o.frequency.value=440;g.gain.setValueAtTime(.0001,t);g.gain.exponentialRampToValueAtTime(.09,t+.01);g.gain.setValueAtTime(.09,t+.30);g.gain.exponentialRampToValueAtTime(.0001,t+3.4);o.connect(g).connect(masterGain);o.start(t);o.stop(t+3.45);nodes.push(o)}document.querySelector('#fork').onclick=tuningFork440;document.querySelector('#listen').onclick=()=>{try{ctx();let current=E(),t=audio.currentTime+.04,b=.42;current.measures.forEach(M=>M.notes.forEach(N=>{tone(N.m,t,b*.9);t+=b}))}catch(err){let m=document.querySelector('#keyMsg');m.className='bad';m.textContent='Erreur audio : '+err.message;console.error(err)}};document.querySelector('#fork2').onclick=()=>document.querySelector('#fork').onclick();document.querySelector('#listen2').onclick=()=>document.querySelector('#listen').onclick();
function setMasterVolume(value){masterVolume=Math.max(0,Math.min(1,Number(value)/100));if(masterGain&&audio)masterGain.gain.setTargetAtTime(masterVolume,audio.currentTime,.015);document.querySelector('#volume').value=Math.round(masterVolume*100);document.querySelector('#volume2').value=Math.round(masterVolume*100);document.querySelector('#volumeValue').textContent=Math.round(masterVolume*100)+'%';document.querySelector('#volumeValue2').textContent=Math.round(masterVolume*100)+'%'}
