function dnote(T,d){let z=d-1,i=((z%7)+7)%7,[l,a]=T.scale[i],oct=Math.floor(T.tonic/12)-1+Math.floor(z/7),m=(oct+1)*12+NAT[l]+a;while(m<T.tonic+12*Math.floor(z/7)){m+=12;oct++}return{l,a,oct,m}}function hz(m){return 440*Math.pow(2,(m-69)/12)}
