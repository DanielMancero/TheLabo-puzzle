function makeEx(i){let T=K[(i*5+i%3)%K.length],c=CON[i],measures=c.map((m,j)=>({id:'ABCD'[j],notes:m.map((d,k)=>({...dnote(T,melodicDegree(d,i,j,k)),dur:1}))}));return{T,measures}}
function shuffleCopy(a){let x=[...a];for(let i=x.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[x[i],x[j]]=[x[j],x[i]]}return x}
